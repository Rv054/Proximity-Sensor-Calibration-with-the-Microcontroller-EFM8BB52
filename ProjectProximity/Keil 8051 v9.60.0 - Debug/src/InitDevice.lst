 498          //================================================================================
 499          // TIMER_SETUP_0_enter_DefaultMode_from_RESET
 500          //================================================================================
 501          extern void TIMER_SETUP_0_enter_DefaultMode_from_RESET(void) {
 502   1        // $[CKCON0 - Clock Control 0]
 503   1        /*
 504   1         // SCA (Timer 0/1 Prescale) = SYSCLK_DIV_12 (System clock divided by 12.)
 505   1         // T0M (Timer 0 Clock Select) = PRESCALE (Counter/Timer 0 uses the clock
 506   1         //     defined by the prescale field, SCA.)
 507   1         // T2MH (Timer 2 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 high
 508   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 509   1         // T2ML (Timer 2 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 low
 510   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 511   1         // T3MH (Timer 3 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 high
 512   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 513   1         // T3ML (Timer 3 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 low
 514   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 515   1         // T1M (Timer 1 Clock Select) = SYSCLK (Timer 1 uses the system clock.)
 516   1         */
 517   1        CKCON0 = CKCON0_SCA__SYSCLK_DIV_12 | CKCON0_T0M__PRESCALE
 518   1            | CKCON0_T2MH__EXTERNAL_CLOCK | CKCON0_T2ML__EXTERNAL_CLOCK
 519   1            | CKCON0_T3MH__EXTERNAL_CLOCK | CKCON0_T3ML__EXTERNAL_CLOCK
 520   1            | CKCON0_T1M__SYSCLK;
 521   1        // [CKCON0 - Clock Control 0]$
 522   1      
 523   1        // $[CKCON1 - Clock Control 1]
 524   1        // [CKCON1 - Clock Control 1]$
 525   1      
 526   1        // $[TMOD - Timer 0/1 Mode]
 527   1        /*
 528   1         // T0M (Timer 0 Mode Select) = MODE0 (Mode 0, 13-bit Counter/Timer)
 529   1         // T1M (Timer 1 Mode Select) = MODE2 (Mode 2, 8-bit Counter/Timer with
 530   1         //     Auto-Reload)
 531   1         // CT0 (Counter/Timer 0 Select) = TIMER (Timer Mode. Timer 0 increments
 532   1         //     on the clock defined by T0M in the CKCON0 register.)
 533   1         // GATE0 (Timer 0 Gate Control) = DISABLED (Timer 0 enabled when TR0 = 1
 534   1         //     irrespective of INT0 logic level.)
 535   1         // CT1 (Counter/Timer 1 Select) = TIMER (Timer Mode. Timer 1 increments
 536   1         //     on the clock defined by T1M in the CKCON0 register.)
 537   1         // GATE1 (Timer 1 Gate Control) = DISABLED (Timer 1 enabled when TR1 = 1
 538   1         //     irrespective of INT1 logic level.)
 539   1         */
 540   1        TMOD = TMOD_T0M__MODE0 | TMOD_T1M__MODE2 | TMOD_CT0__TIMER
 541   1            | TMOD_GATE0__DISABLED | TMOD_CT1__TIMER | TMOD_GATE1__DISABLED;
 542   1        // [TMOD - Timer 0/1 Mode]$
 543   1      
 544   1        // $[TCON - Timer 0/1 Control]
 545   1        /*
 546   1         // TR1 (Timer 1 Run Control) = RUN (Start Timer 1 running.)
 547   1         */
 548   1        TCON |= TCON_TR1__RUN;
 549   1        // [TCON - Timer 0/1 Control]$
 550   1      
 551   1      }
